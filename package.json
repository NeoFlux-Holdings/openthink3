{
  "name": "openthink3",
  "private": true,
  "version": "0.1.0",
  "description": "A personal AI agent that lives on your own Cloudflare account.",
  "license": "Apache-2.0",
  "author": "Thomas Zarebczan <tom@odysee.com>",
  "homepage": "https://openthink.run",
  "repository": {
    "type": "git",
    "url": "https://github.com/NeoFlux-Holdings/openthink3.git"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "verify": "node tools/verify/verify.mjs",
    "deploy:platform": "pnpm --filter @openthink/platform run deploy",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
