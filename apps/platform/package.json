{
  "name": "@openthink/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n worker,web -c yellow,cyan \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:worker": "wrangler dev --local --port 8787",
    "dev:web": "vite",
    "build": "pnpm build:web && pnpm build:worker",
    "build:web": "vite build",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "pnpm build:web && wrangler deploy",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@cloudflare/ai-chat": "^0.7.1",
    "@openthink/agents-core": "workspace:*",
    "@openthink/browser": "workspace:*",
    "@openthink/memory": "workspace:*",
    "@openthink/skills": "workspace:*",
    "@openthink/ui": "workspace:*",
    "@openthink/workflows": "workspace:*",
    "@phosphor-icons/react": "^2",
    "@streamdown/code": "^1",
    "agents": "^0.13.2",
    "ai": "^6.0.188",
    "hono": "^4.6.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "streamdown": "^2",
    "workers-ai-provider": "^3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "wrangler": "^4.93.1"
  },
  "optionalDependencies": {
    "@cloudflare/puppeteer": "^0.0.14",
    "@cloudflare/sandbox": "^0.4.2"
  }
}
